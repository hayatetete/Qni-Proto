      "versionNonce": 276747930,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1768454846171,
      "link": null,
      "locked": false,
      "text": "右横ペースト時、対象ステップの右へゲート挿\n入（既存ゲートは押し出し）",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "右横ペースト時、対象ステップの右へゲート挿入（既存ゲートは押し出し）",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "MobAokuQA4hftLds0RMvS",
      "type": "text",
      "x": 14831.454798374813,
      "y": 1636.374572857785,
      "width": 735.803955078125,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c9K3",
      "roundness": null,
      "seed": 645003445,
      "version": 8,
      "versionNonce": 1551038470,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1768454846171,
      "link": null,
      "locked": false,
      "text": "下ペースト時、qubit数を追加しつつ挿入（最\n大32qubitまで）",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "下ペースト時、qubit数を追加しつつ挿入（最大32qubitまで）",
