    {
      "id": "eKjR9iK78HEKm8UjUD2uu",
      "type": "text",
      "x": 14661.30304313904,
      "y": -25.558048307135323,
      "width": 1452.9958097510569,
      "height": 25.22562169706696,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
