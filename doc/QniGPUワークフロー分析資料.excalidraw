    {
      "id": "7o_MSdJDbOr6Rd67ShbFV",
      "type": "text",
      "x": 12952.83272618415,
      "y": 964.7144277878481,
      "width": 580,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c9JO",
