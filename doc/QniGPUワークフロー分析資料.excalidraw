      "boundElements": [],
      "updated": 1768454846171,
      "link": null,
      "locked": false,
      "text": "パレットからのドラッグを極力使わずに量子回路を構築する",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "パレットからのドラッグを極力使わずに量子回路を構築する",
      "autoResize": true,
      "lineHeight": 1.25
    },
