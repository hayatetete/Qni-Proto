      "seed": 1584107028,
      "version": 345,
      "versionNonce": 971727322,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1768454846171,
      "link": null,
      "locked": false,
      "text": "　・Ctrl + C : コピー\n　・Ctrl + V : 横ペースト\n　・Ctrl + Shift + V : 縦ペースト （最大32qubit）",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "　・Ctrl + C : コピー\n　・Ctrl + V : 横ペースト\n　・Ctrl + Shift + V : 縦ペースト （最大32qubit）",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "1T-zLkhA7Eu50bp_NS0fX",
      "type": "text",
      "x": 4677.88533704714,
      "y": 2302.6234636492486,
      "width": 480,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c9Bl",
      "roundness": null,
      "seed": 1064872852,
      "version": 205,
      "versionNonce": 911720646,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1768454846171,
      "link": null,
      "locked": false,
      "text": "・キー連打で、選択したゲート基準に連続で複製可能\n・任意のステップをクリックしてそのステップの\n   一番上にもペースト可能\n\n・任意のステップをクリックして\n   そのステップの一番上にもペースト可能\n\n・上・左にはペーストはしない",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "・キー連打で、選択したゲート基準に連続で複製可能\n・任意のステップをクリックしてそのステップの\n   一番上にもペースト可能\n\n・任意のステップをクリックして\n   そのステップの一番上にもペースト可能\n\n・上・左にはペーストはしない",
      "autoResize": true,
      "lineHeight": 1.25
    },
