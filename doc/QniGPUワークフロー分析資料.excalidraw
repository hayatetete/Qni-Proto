      "seed": 230202363,
      "version": 8,
      "versionNonce": 917104538,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1768454846171,
      "link": null,
      "locked": false,
      "text": "まずコピペやペースト方法・基準ゲートの流れを理解し、その後\nで「複数選択」の拡張パターンに進む。",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "まずコピペやペースト方法・基準ゲートの流れを理解し、その後で「複数選択」の拡張パターンに進む。",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "5dE-CKpwsipux4KNnj_MZ",
      "type": "text",
      "x": 13112.83272618415,
      "y": 1037.214427787848,
      "width": 260,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c9JP",
      "roundness": null,
      "seed": 1017869621,
      "version": 8,
      "versionNonce": 1325233926,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1768454846171,
      "link": null,
      "locked": false,
      "text": "複数選択は基本操作の拡張。",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "複数選択は基本操作の拡張。",
      "autoResize": true,
      "lineHeight": 1.25
    },
