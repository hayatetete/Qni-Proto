    {
      "id": "EgEPV4glqFbBxN1GQKNKI",
      "type": "text",
      "x": 14737.947297936069,
      "y": 183.17442332165228,
      "width": 168.12890625,
      "height": 123.60002517700195,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c9Jv",
