      "updated": 1768454846171,
      "link": null,
      "locked": false,
      "text": "下ペースト時、選択分のqubit（行）を追加",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "下ペースト時、選択分のqubit（行）を追加",
