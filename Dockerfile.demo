FROM node:20-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    QNI_BIND_HOST=0.0.0.0 \
    QNI_PUBLIC_HOST=127.0.0.1 \
    QNI_FRONTEND_PORT=5173 \
    QNI_BACKEND_PORT=8000 \
    PATH=/opt/qni-venv/bin:$PATH \
    PIP_CERT=/etc/ssl/certs/ca-certificates.crt \
    NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git python3 python3-pip python3-venv \
    && python3 -m venv /opt/qni-venv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/qni
COPY . .

RUN if [ -f cert_Authentication_Cookie_CA.crt ]; then \
        install -m 0644 cert_Authentication_Cookie_CA.crt /usr/local/share/ca-certificates/qni-local-ca.crt; \
        update-ca-certificates; \
    fi \
    && rm -f cert_Authentication_Cookie_CA.crt \
    && python -m pip install --no-cache-dir -e . -e ./backend jupyterlab \
    && cd frontend \
    && node .yarn/releases/yarn-4.4.1.cjs install --immutable

EXPOSE 5173 8000 8888

CMD ["jupyter", "lab", "qni_demo.ipynb", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--allow-root", "--ServerApp.token=", "--ServerApp.password="]
